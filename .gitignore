# P07_SquadQuery repository: docs + the UE project in SquadQuery/.
# Generated by Unreal / Visual Studio. Never commit.
SquadQuery/Binaries/
SquadQuery/Intermediate/
SquadQuery/Saved/
SquadQuery/DerivedDataCache/
SquadQuery/Build/
SquadQuery/Plugins/*/Binaries/
SquadQuery/Plugins/*/Intermediate/
SquadQuery/.vs/
SquadQuery/*.sln
SquadQuery/*.slnx
*.VC.db
*.opensdf
*.sdf
*.suo

# Python
__pycache__/

# Packaged builds stay out of git.
Build/

# Benchmarks: raw captures, run reports and logs stay local (too large for git; UE logs also hold
# machine-specific paths). Manifests and Summaries/ are committed; cited raw batches go to GitHub Releases.
Benchmarks/Raw/*
!Benchmarks/Raw/*_manifest.json
Benchmarks/*_console.txt

# Local drafts (code and doc fragments parked between steps). Never commit.
_wip/

# Portfolio export for Google Drive (images, video, description). Never commit.
Portfolio/
